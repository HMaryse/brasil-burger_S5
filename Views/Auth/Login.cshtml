@{
    ViewData["Title"] = "Connexion";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background: linear-gradient(120deg, #f5f6fa 0%, #ffe5c2 100%);
        font-family: 'Segoe UI', sans-serif;
    }

    .login-container {
        min-height: 100vh;
    }

    .login-box {
        width: 460px;
        background: white;
        padding: 40px 42px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .brand {
        color: #8B1329;
        font-weight: 800;
    }

    .brand i {
        color: #FFA629;
    }

    .btn-login {
        background: linear-gradient(90deg, #FFA629 0%, #8B1329 100%);
        color: white;
        width: 100%;
        font-weight: 600;
        border-radius: 30px;
        padding: 10px;
        font-size: 1rem;
        border: none;
    }

    .btn-login:hover {
        opacity: 0.9;
        color: white;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px 14px;
    }

    .input-group-text {
        background: #f8f9fa;
        border-radius: 10px 0 0 10px;
    }

    .divider {
        height: 1px;
        background: #e0e0e0;
        margin: 20px 0;
    }

    .info-text {
        background: #fff6e5;
        border-left: 4px solid #FFA629;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
    }
</style>

<div class="container login-container d-flex justify-content-center align-items-center">

    <div class="login-box">

        
        <div class="text-center mb-3">
            <h3 class="brand mb-1">
                <i class="bi bi-shop"></i> Brasil Burger
            </h3>
            <p class="text-muted small mb-0">
                Connectez-vous pour continuer votre commande
            </p>
        </div>

        <div class="divider"></div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger small text-center">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @ViewBag.Error
            </div>
        }

        
        <form method="post">

            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

           
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="bi bi-telephone-fill"></i>
                </span>
                <input type="text"
                       name="Telephone"
                       class="form-control"
                       placeholder="+221 XX XXX XX XX"
                       required />
            </div>

            <div class="input-group mb-4">
                <span class="input-group-text">
                    <i class="bi bi-lock-fill"></i>
                </span>
                <input type="password"
                       name="MotDePasse"
                       class="form-control"
                       placeholder="Mot de passe"
                       required />
            </div>

            <button type="submit" class="btn btn-login">
                <i class="bi bi-box-arrow-in-right"></i> Se connecter
            </button>
        </form>

        <div class="divider"></div>

        <div class="info-text text-center mb-3">
            <i class="bi bi-info-circle-fill"></i>
            Vous serez redirigé automatiquement vers la page demandée.
        </div>

        <div class="text-center small">
            Pas encore de compte ?
            <a href="/Auth/Register" class="fw-semibold">Créer un compte</a>
        </div>

    </div>
</div>
