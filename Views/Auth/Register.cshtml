@model Models.Client

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background: linear-gradient(120deg, #f5f6fa 0%, #ffe5c2 100%);
        font-family: 'Segoe UI', sans-serif;
    }

    .register-container {
        min-height: 100vh;
    }

    .register-box {
        width: 520px;
        background: white;
        padding: 45px 48px;
        border-radius: 20px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    }

    .brand {
        color: #8B1329;
        font-weight: 800;
    }

    .brand i {
        color: #FFA629;
    }

    .form-control {
        border-radius: 12px;
        padding: 11px 14px;
    }

    textarea.form-control {
        resize: none;
    }

    .input-group-text {
        background: #f8f9fa;
        border-radius: 12px 0 0 12px;
    }

    .btn-submit {
        background: linear-gradient(90deg, #FFA629 0%, #8B1329 100%);
        color: white;
        width: 100%;
        font-weight: 600;
        border-radius: 30px;
        padding: 11px;
        font-size: 1rem;
        border: none;
    }

    .btn-submit:hover {
        opacity: 0.9;
        color: white;
    }

    .divider {
        height: 1px;
        background: #e0e0e0;
        margin: 22px 0;
    }

    .info-text {
        background: #fff6e5;
        border-left: 4px solid #FFA629;
        padding: 12px 15px;
        border-radius: 10px;
        font-size: 0.85rem;
    }
</style>

<div class="container register-container d-flex justify-content-center align-items-center">

    <div class="register-box">

        
        <div class="text-center mb-3">
            <h3 class="brand mb-1">
                <i class="bi bi-shop"></i> Brasil Burger
            </h3>
            <p class="text-muted small mb-0">
                Créez votre compte pour commander facilement
            </p>
        </div>

        <div class="divider"></div>

        
        <form method="post">

            
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="bi bi-person-fill"></i>
                </span>
                <input name="NomComplet"
                       class="form-control"
                       placeholder="Nom complet"
                       required />
            </div>

            
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="bi bi-telephone-fill"></i>
                </span>
                <input type="text"
                       name="Telephone"
                       class="form-control"
                       placeholder="+221 XX XXX XX XX"
                       required />
            </div>

            
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="bi bi-geo-alt-fill"></i>
                </span>
                <textarea name="Adresse"
                          class="form-control"
                          placeholder="Adresse de livraison"
                          rows="2"
                          required></textarea>
            </div>

            
            <div class="input-group mb-4">
                <span class="input-group-text">
                    <i class="bi bi-lock-fill"></i>
                </span>
                <input type="password"
                       name="MotDePasse"
                       class="form-control"
                       placeholder="Mot de passe"
                       required />
            </div>

            <button type="submit" class="btn btn-submit">
                <i class="bi bi-person-plus-fill"></i> Créer mon compte
            </button>
        </form>

        <div class="divider"></div>

        <div class="info-text text-center mb-3">
            <i class="bi bi-info-circle-fill"></i>
            Vos informations sont nécessaires...
        </div>

        <div class="text-center small">
            Déjà un compte ?
            <a href="/Auth/Login" class="fw-semibold">Se connecter</a>
        </div>

    </div>
</div>
