@model ViewModels.PanierViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body { background: #f4f5f7; }

    .page-title {
        font-weight: 700;
        color: #8B1329;
    }

    .panier-card {
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        border: none;
    }

    .price {
        color: #8B1329;
        font-weight: 700;
    }

    .btn-action {
        border-radius: 50px;
    }

    .resume-card {
        border-radius: 14px;
        border: none;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }

    .btn-pay {
        background: linear-gradient(90deg,#FFA629 0%,#8B1329 100%);
        color: white;
        font-weight: 600;
        border-radius: 10px;
    }

    .btn-pay:hover {
        opacity: 0.9;
        color: white;
    }

    .badge-type {
        background: #FFA629;
        color: #212529;
    }
</style>

<div class="container mt-4">

    <!--Haut -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/Dashboard/Index" class="text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left-circle"></i> Retour au catalogue
        </a>

        <div class="fw-semibold">
            <i class="bi bi-person-circle text-warning"></i>
            @Context.Session.GetString("ClientNom")
        </div>
    </div>

    <h3 class="page-title mb-4">
        <i class="bi bi-cart-fill"></i> Mon Panier
    </h3>

    <div class="row">

        <!-- LISTE PANIER -->
        <div class="col-md-8">
            @foreach (var item in Model.Items)
            {
                <div class="card panier-card mb-3 p-3 d-flex flex-row gap-3">
                    <img src="@item.ImageUrl"
                         width="120" height="120"
                         style="object-fit:cover;border-radius:10px">

                    <div class="flex-grow-1">
                        <h6 class="fw-bold">@item.Nom</h6>

                        <span class="badge badge-type mb-2">
                            <i class="bi bi-tag-fill"></i> @item.Type
                        </span>

                        <p class="mt-2 mb-1">
                            Prix unitaire :
                            <span class="price">@item.Prix FCFA</span>
                        </p>

                        <div class="d-flex align-items-center gap-2 mt-2">
                            <a href="/Commande/Diminuer?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-secondary btn-sm btn-action">
                                <i class="bi bi-dash"></i>
                            </a>

                            <strong>@item.Quantite</strong>

                            <a href="/Commande/Augmenter?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-secondary btn-sm btn-action">
                                <i class="bi bi-plus"></i>
                            </a>

                            <a href="/Commande/Supprimer?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-danger btn-sm btn-action ms-3">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>

                        @if (item.Type == "BURGER" || item.Type == "MENU")
                        {
                            <a href="/Commande/Complements?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-warning btn-sm mt-3 btn-action">
                                <i class="bi bi-plus-circle"></i> Ajouter des compléments
                            </a>
                        }
                    </div>

                    <div class="fw-bold price fs-5">
                        @(item.Prix * item.Quantite) FCFA
                    </div>
                </div>
            }
        </div>

        <!-- RÉSUMÉ -->
        <div class="col-md-4">
            <div class="card resume-card p-3">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-receipt"></i> Résumé
                </h6>

                <p>
                    <i class="bi bi-box"></i>
                    Articles : <strong>@Model.TotalArticles</strong>
                </p>

                <p>
                    <i class="bi bi-cash-stack"></i>
                    Total : <strong class="price">@Model.Total FCFA</strong>
                </p>

                <hr>

                <h6 class="fw-bold">
                    <i class="bi bi-credit-card"></i> Paiement
                </h6>

                <div class="form-check">
                    <input class="form-check-input" type="radio" checked>
                    <label class="form-check-label">
                        <i class="bi bi-phone-fill text-success"></i> Wave
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio">
                    <label class="form-check-label">
                        <i class="bi bi-phone-fill text-warning"></i> Orange Money
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio">
                    <label class="form-check-label">
                        <i class="bi bi-cash-coin"></i> Espèces
                    </label>
                </div>

                <button class="btn btn-pay w-100 mt-2">
                    <i class="bi bi-check-circle-fill"></i> Passer à la caisse
                </button>

                <div class="text-center mt-3 small text-muted">
                    <i class="bi bi-shield-check text-success"></i>
                    Paiement sécurisé
                </div>
            </div>
        </div>

    </div>
</div>
