@model ViewModels.PanierViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background: #f4f5f7;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-title {
        font-weight: 700;
        color: #8B1329;
    }

    .panier-card {
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        border: none;
        transition: 0.2s;
    }

    .panier-card:hover {
        transform: translateY(-3px);
    }

    .price {
        color: #8B1329;
        font-weight: 700;
    }

    .btn-action {
        border-radius: 50px;
    }

    .resume-card {
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        background: white;
    }

    .badge-type {
        background: #FFA629;
        color: #212529;
        font-weight: 600;
        border-radius: 20px;
        padding: 4px 10px;
    }

    .client-box {
        background: linear-gradient(90deg,#FFA629 0%,#8B1329 100%);
        color: white;
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    }

    .client-box i {
        color: white;
    }
</style>

<div class="container mt-4">

    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/Dashboard/Index" class="text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left-circle"></i> Retour au catalogue
        </a>

        <a href="/Commande/MesCommandes" class="btn btn-dark rounded-pill btn-sm">
            <i class="bi bi-box-seam"></i> Mes commandes
        </a>
    </div>

    
    <div class="client-box mb-4">
        <h6 class="fw-bold mb-1">
            <i class="bi bi-person-circle"></i>
            @Context.Session.GetString("ClientNom")
        </h6>

        <small>
            <i class="bi bi-geo-alt-fill"></i>
            @Context.Session.GetString("ClientAdresse")
        </small>
    </div>

    <h3 class="page-title mb-4">
        <i class="bi bi-cart-fill"></i> Mon Panier
    </h3>

    <div class="row">

       
        <div class="col-md-8">
            @if (!Model.Items.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle"></i>
                    Votre panier est vide.
                </div>
            }

            @foreach (var item in Model.Items)
            {
                <div class="card panier-card mb-3 p-3 d-flex flex-row gap-3">
                    <img src="@item.ImageUrl"
                         width="120" height="120"
                         style="object-fit:cover;border-radius:12px">

                    <div class="flex-grow-1">
                        <h6 class="fw-bold">@item.Nom</h6>

                        <span class="badge badge-type mb-2">
                            <i class="bi bi-tag-fill"></i> @item.Type
                        </span>

                        <p class="mt-2 mb-1">
                            Prix unitaire :
                            <span class="price">@item.Prix FCFA</span>
                        </p>

                        <div class="d-flex align-items-center gap-2 mt-2">
                            <a href="/Commande/Diminuer?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-secondary btn-sm btn-action">
                                <i class="bi bi-dash"></i>
                            </a>

                            <strong>@item.Quantite</strong>

                            <a href="/Commande/Augmenter?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-secondary btn-sm btn-action">
                                <i class="bi bi-plus"></i>
                            </a>

                            <a href="/Commande/Supprimer?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-danger btn-sm btn-action ms-3">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>

                        @if (item.Type == "BURGER" || item.Type == "MENU")
                        {
                            <a href="/Commande/Complements?id=@item.Id&type=@item.Type"
                               class="btn btn-outline-warning btn-sm mt-3 btn-action">
                                <i class="bi bi-plus-circle"></i> Ajouter des compléments
                            </a>
                        }
                    </div>

                    <div class="fw-bold price fs-5 align-self-center">
                        @(item.Prix * item.Quantite) FCFA
                    </div>
                </div>
            }
        </div>

       
        <div class="col-md-4">
            <div class="card resume-card p-4">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-receipt"></i> Résumé de la commande
                </h6>

                <p class="mb-2">
                    <i class="bi bi-box"></i>
                    Articles :
                    <strong>@Model.TotalArticles</strong>
                </p>

                <p class="mb-3">
                    <i class="bi bi-cash-stack"></i>
                    Total :
                    <strong class="price fs-5">@Model.Total FCFA</strong>
                </p>

                <hr>

                <a href="/Commande/Valider" class="btn btn-success w-100 fw-semibold">
                    <i class="bi bi-check-circle-fill"></i>
                    Continuer la commande
                </a>

                <div class="text-center mt-3 small text-muted">
                    <i class="bi bi-shield-check text-success"></i>
                    Commande sécurisée
                </div>
            </div>
        </div>

    </div>
</div>
