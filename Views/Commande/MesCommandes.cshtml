@model List<Models.Commande>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background: #f5f6fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-title {
        font-weight: 800;
        color: #8B1329;
    }

    .commande-card {
        background: white;
        border-radius: 18px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.1);
        padding: 24px;
        margin-bottom: 25px;
    }

    .badge-statut {
        background: linear-gradient(90deg, #FFA629, #ff7a18);
        color: #000;
        font-weight: 700;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.85rem;
    }

    
    .timeline {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
        padding: 0 10px;
    }

    .timeline-step {
        text-align: center;
        flex: 1;
        position: relative;
    }

    .timeline-step::after {
        content: "";
        position: absolute;
        top: 18px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #ffd7a8;
        z-index: 0;
    }

    .timeline-step:last-child::after {
        display: none;
    }

    .timeline-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #ffe0b2;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 18px;
        z-index: 1;
        position: relative;
    }

    .timeline-step.active .timeline-circle {
        background: linear-gradient(135deg, #FFA629, #8B1329);
        color: white;
    }

    .timeline-label {
        font-size: 0.8rem;
        margin-top: 8px;
        font-weight: 600;
        color: #8B1329;
    }

    .total {
        font-size: 1.3rem;
        font-weight: bold;
        color: #8B1329;
    }

    
    .pagination .page-link {
        border-radius: 8px;
        margin: 0 4px;
        font-weight: 600;
        color: #8B1329;
    }

    .pagination .active > .page-link {
        background-color: #8B1329;
        border-color: #8B1329;
        color: white;
    }
</style>

<div class="container py-4">

   
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/Dashboard/Index" class="fw-semibold text-decoration-none">
            <i class="bi bi-arrow-left"></i> Retour à l'accueil
        </a>

        <a href="/Commande/Panier" class="btn btn-outline-dark rounded-pill">
            <i class="bi bi-cart3"></i> Panier
        </a>
    </div>

    <h3 class="page-title mb-4">
        <i class="bi bi-box-seam"></i> Mes Commandes
    </h3>

    @foreach (var cmd in Model)
    {
        <div class="commande-card">

            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Commande #@cmd.Id</h5>
                <span class="badge-statut">@cmd.Statut</span>
            </div>

            <small class="text-muted">
                <i class="bi bi-calendar-event"></i>
                @cmd.DateCommande.ToString("dd/MM/yyyy HH:mm")
            </small>

            <div class="row mt-3">
                <div class="col-md-6">
                    <p class="mb-1">
                        <b>Mode :</b> @cmd.ModeConsommation
                    </p>

                    <p class="mb-1">
                        <b>Paiement :</b> @(cmd.EstPaye ? "Payé" : "Non payé")
                    </p>

                    @if (cmd.ModeConsommation == Models.ModeConsommation.LIVRAISON)
                    {
                        <p class="mb-1">
                            <b>Adresse :</b> @cmd.Adresse
                        </p>
                    }
                </div>

                <div class="col-md-6 text-end align-self-end">
                    <div class="total">
                        @{
                            var total = cmd.Items.Sum(i => i.PrixTotal);
                        }
                        Total : @total FCFA
                    </div>
                </div>
            </div>

           
            <div class="timeline">
                <div class="timeline-step active">
                    <div class="timeline-circle">🧾</div>
                    <div class="timeline-label">Reçue</div>
                </div>

                <div class="timeline-step @(cmd.Statut != Models.StatutCommande.EN_COURS ? "active" : "")">
                    <div class="timeline-circle">👨‍🍳</div>
                    <div class="timeline-label">Préparation</div>
                </div>

                <div class="timeline-step @(cmd.ModeConsommation == Models.ModeConsommation.LIVRAISON && cmd.Statut != Models.StatutCommande.EN_COURS ? "active" : "")">
                    <div class="timeline-circle">🛵</div>
                    <div class="timeline-label">En route</div>
                </div>

                <div class="timeline-step @(cmd.Statut == Models.StatutCommande.TERMINEE ? "active" : "")">
                    <div class="timeline-circle">✔</div>
                    <div class="timeline-label">Livrée</div>
                </div>
            </div>

        </div>
    }

    
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.Page - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                        <a class="page-link" href="?page=@i">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.Page == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.Page + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>
