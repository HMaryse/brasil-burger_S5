@model ViewModels.ChoixCommandeViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body { background:#f4f5f7; }

    .container-full {
        width:100%;
        padding:40px 60px;
    }

    .article-card, .complement-card {
        background:white;
        border-radius:12px;
        padding:20px;
        box-shadow:0 2px 8px rgba(0,0,0,0.08);
    }

    .btn-main {
        background:linear-gradient(90deg,#FFA629 0%,#8B1329 100%);
        color:white;
        font-weight:600;
        border:none;
        padding:12px;
        width:100%;
        border-radius:8px;
    }
</style>

<div class="container-full">

    
    <a href="/Dashboard" class="text-decoration-none mb-3 d-inline-block">
        ← Retour au catalogue
    </a>

    <div class="row mt-3">

        <!-- ARTICLE -->
        <div class="col-md-6">
            <div class="article-card">

                <h4 class="fw-bold">
                    @(Model.Type == "BURGER" ? Model.Burger.Nom : Model.Menu.Nom)
                </h4>

                <p class="text-muted">
                    Prix :
                    @(Model.Type == "BURGER" ? Model.Burger.Prix : Model.Menu.Prix) FCFA
                </p>

                <label>Quantité</label>
                <input type="number" name="Quantite" value="1" class="form-control w-25">
            </div>
        </div>

        <!-- COMPLEMENTS -->
        <div class="col-md-6">
            <div class="complement-card">

                <h5 class="fw-bold mb-3">Compléments (optionnels)</h5>

                <form method="post" action="/Commande/AjouterAuPanier">

                    <input type="hidden" name="ArticleId" value="@Model.ArticleId" />
                    <input type="hidden" name="Type" value="@Model.Type" />

                    @foreach (var c in Model.Complements)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="ComplementIds"
                                   value="@c.Id">
                            <label class="form-check-label">
                                @c.Nom (+@c.Prix FCFA)
                            </label>
                        </div>
                    }

                    <button class="btn-main mt-4">
                        Ajouter au panier
                    </button>

                </form>
            </div>
        </div>

    </div>
</div>
