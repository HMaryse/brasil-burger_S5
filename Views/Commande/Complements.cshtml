@model ViewModels.ComplementSelectionViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body { background: #f4f5f7; }

    .complement-card {
        border-radius: 14px;
        border: none;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        transition: 0.2s;
    }

    .complement-card:hover {
        transform: translateY(-4px);
    }

    .btn-add {
        background: linear-gradient(90deg,#FFA629 0%,#8B1329 100%);
        color: white;
        font-weight: 600;
        border-radius: 10px;
    }

    .btn-add:hover {
        opacity: 0.9;
        color: white;
    }
</style>

<div class="container mt-4">

    <a href="/Commande/Panier" class="text-decoration-none fw-semibold">
        <i class="bi bi-arrow-left-circle"></i> Retour au panier
    </a>

    <h4 class="mt-3 fw-bold text-danger">
        <i class="bi bi-plus-circle-fill"></i>
        Ajouter des compléments
    </h4>

    <p class="text-muted">
        Choisissez les compléments que vous souhaitez ajouter à votre commande
    </p>

    <form method="post" action="/Commande/AjouterComplements">

        <input type="hidden" name="ArticleId" value="@Model.ArticleId" />
        <input type="hidden" name="Type" value="@Model.Type" />

        <div class="row mt-4">
            @foreach (var c in Model.Complements)
            {
                <div class="col-md-4">
                    <div class="card complement-card p-3 mb-4 text-center">
                        <img src="@c.ImageUrl"
                             height="140"
                             style="object-fit:cover;border-radius:10px">

                        <h6 class="fw-bold mt-3">@c.Nom</h6>
                        <p class="text-warning fw-semibold">@c.Prix FCFA</p>

                        <div class="form-check mt-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedComplementIds"
                                   value="@c.Id">
                            <label class="form-check-label">
                                Ajouter
                            </label>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button class="btn btn-add px-4">
            <i class="bi bi-cart-plus-fill"></i> Ajouter au panier
        </button>
    </form>

</div>
