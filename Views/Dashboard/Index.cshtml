@model ViewModels.CatalogueViewModel

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Brasil Burger - Accueil Client</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f5f6fa;
            font-family: 'Segoe UI', sans-serif;
        }

        /*  BANDE*/
        .hero-wrapper {
            width: 100vw;
            margin-left: calc(-50vw + 50%);
            margin-right: calc(-50vw + 50%);
        }

        .hero {
            background: linear-gradient(90deg, #FFA629 0%, #8B1329 100%);
            color: white;
            padding: 70px 20px;
            border-radius: 0;
            margin-bottom: 25px;
            width: 100vw;
            margin-left: calc(-50vw + 50%);
            
        }

        .hero-icon {
            font-size: 45px;
            opacity: 0.9;
        }

        /*  SEARCH  */
        .search-bar {
            background: white;
            padding: 10px;
            border-radius: 50px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        /*  FILTERS  */
        .filter-btn {
            border-radius: 50px;
            font-weight: 600;
            background: white;
        }

        .filter-btn.active {
            background: #FFA629;
           
        }

        /*  CARDS  */
        .product-card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-4px);
        }

        .badge-tag {
            background: #e89b1e;
            color: white;
            border-radius: 50px;
            padding: 5px 12px;
            font-size: 0.75rem;
        }

        /*  BUTTON COMMANDER  */
        .btn-order {
            background: linear-gradient(90deg, #FFA629 0%, #8B1329 100%);
            color: #FFFFFF;
            border-radius: 50px;
            font-weight: 600;
            padding: 8px 18px;
            border: none;
        }

        .btn-order:hover {
            background: #e89b1e;
            color: #FFFFFF;
        }

        .price {
            font-size: 1.1rem;
            font-weight: bold;
            color: #FFA629;
        }

        /*  PAGINATION  */
        .pagination .page-link {
            border-radius: 8px;
            margin: 0 4px;
            font-weight: 600;
            color: #8B1329;
        }

        .pagination .active > .page-link {
            background-color: #8B1329;
            border-color: #8B1329;
            color: white;
        }
    </style>
</head>

<body>

<div class="container py-3">

    <!-- TOP -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="fw-bold fs-5">
            <i class="bi bi-shop text-danger"></i> Brasil Burger
        </div>
        <button class="btn btn-dark btn-sm rounded">
            <i class="bi bi-person-badge"></i> Mode Gestionnaire
        </button>
    </div>

</div>

<!-- HERO FULL WIDTH -->
<div class="hero-wrapper">
    <div class="hero text-center">
        <i class="bi bi-cube hero-icon"></i>
        <h2 class="mt-3 fw-bold">Bienvenue chez Brasil Burger</h2>
        <p class="mt-2">Les meilleurs burgers de Dakar, préparés avec passion</p>

        <div class="d-flex justify-content-center gap-5 mt-4">
            <div>
                <i class="bi bi-fire fs-4"></i><br>
                <small>Fraîcheur</small>
            </div>
            <div>
                <i class="bi bi-lightning-charge fs-4"></i><br>
                <small>Rapidité</small>
            </div>
            <div>
                <i class="bi bi-patch-check fs-4"></i><br>
                <small>Qualité</small>
            </div>
        </div>
    </div>
</div>

<div class="container">

    <!-- RECHERCHE ET FILTRE -->
    <div class="row mb-4">
        <div class="col-md-7">
            <div class="search-bar d-flex align-items-center">
                <i class="bi bi-search ms-2 text-muted"></i>
                <input type="text" class="form-control border-0 ms-2"
                       placeholder="Rechercher un burger ou menu...">
            </div>
        </div>

        <div class="col-md-5 d-flex justify-content-center gap-2 mt-3 mt-md-0">
            <a href="?type=ALL" class="btn filter-btn @(Model.Type=="ALL"?"active":"")">Tous</a>
            <a href="?type=BURGER" class="btn filter-btn @(Model.Type=="BURGER"?"active":"")">Burgers</a>
            <a href="?type=MENU" class="btn filter-btn @(Model.Type=="MENU"?"active":"")">Menus</a>
        </div>
    </div>

    <!-- PRODUITS -->
    <div class="row g-4">

        @foreach (var b in Model.Burgers)
        {
            <div class="col-md-4">
                <div class="card product-card">
                    <span class="badge-tag position-absolute m-2">Burger</span>
                    <img src="@b.ImageUrl" class="card-img-top" height="220" style="object-fit: cover;">
                    <div class="card-body">
                        <h6 class="fw-bold">@b.Nom</h6>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="price">@b.Prix FCFA</span>
                            <button class="btn btn-order">Commander</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @foreach (var m in Model.Menus)
        {
            <div class="col-md-4">
                <div class="card product-card">
                    <span class="badge-tag position-absolute m-2">Menu</span>
                    <img src="@m.ImageUrl" class="card-img-top" height="220" style="object-fit: cover;">
                    <div class="card-body">
                        <h6 class="fw-bold">@m.Nom</h6>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="price">@m.Prix FCFA</span>
                            <button class="btn btn-order">Commander</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <!-- PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-5">
            <ul class="pagination">

                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="?type=@Model.Type&page=@(Model.Page - 1)">
                        <i class="bi bi-chevron-left"></i> Précédent
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="?type=@Model.Type&page=@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?type=@Model.Type&page=@(Model.Page + 1)">
                        Suivant <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </div>
    }

</div>

</body>
</html>
