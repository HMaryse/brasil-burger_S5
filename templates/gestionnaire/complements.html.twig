{% extends 'base.html.twig' %}

{% block title %}Gestion des Compléments{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h4>Gestion des Compléments</h4>
        <p class="text-muted">Gérer les boissons, frites et autres compléments</p>
    </div>

    <a href="{{ path('app_gestionnaire_complement_add') }}"
       class="btn btn-warning text-white">
        <i class="fa-solid fa-plus"></i> Ajouter un complément
    </a>
</div>

<div class="row g-4 mt-3">

    {% for complement in complements %}
        <div class="col-md-4">
            <div class="card shadow-sm rounded-4 border-0 position-relative">

                <img src="{{ complement.imageUrl ?: 'https://images.unsplash.com/photo-1540189549336-e6e99c3679fe' }}"
                     class="card-img-top rounded-top-4"
                     style="height:180px; object-fit:cover;">

                {% if complement.etat.value == 'DISPONIBLE' %}
                    <span class="badge bg-success position-absolute m-2">
                        Disponible
                    </span>
                {% else %}
                    <span class="badge bg-secondary position-absolute m-2">
                        Indisponible
                    </span>
                {% endif %}

                <div class="card-body">
                    <h6 class="fw-bold mb-1">{{ complement.nom }}</h6>
                    <p class="text-danger fw-bold mb-3">
                        {{ complement.prix }} FCFA
                    </p>

                    <div class="d-flex gap-2">
                        <a href="{{ path('app_gestionnaire_complement_edit', {id: complement.id}) }}"
                           class="btn btn-outline-primary btn-sm w-50">
                            <i class="fa-solid fa-pen"></i> Modifier
                        </a>

                        <form method="post"
                              action="{{ path('app_gestionnaire_complement_delete', {id: complement.id}) }}"
                              class="w-50"
                              onsubmit="return confirm('Supprimer ce complément ?');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete_complement_' ~ complement.id) }}">
                            <button class="btn btn-outline-danger btn-sm w-100">
                                <i class="fa-solid fa-trash"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucun complément trouvé.</p>
    {% endfor %}

</div>


{% if totalPages is defined and totalPages > 1 %}
<nav class="mt-4">
    <ul class="pagination justify-content-center">
        {% for i in 1..totalPages %}
            <li class="page-item {{ page == i ? 'active' }}">
                <a class="page-link"
                   href="{{ path('app_gestionnaire_complements', {page: i}) }}">
                    {{ i }}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}

{% endblock %}
