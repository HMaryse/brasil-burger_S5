{% extends 'base.html.twig' %}

{% block title %}Gestion des Burgers{% endblock %}

{% block body %}


<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Gestion des Burgers</h3>
        <p class="text-muted mb-0">Ajouter, modifier ou supprimer les burgers</p>
    </div>

    <a href="{{ path('app_gestionnaire_burger_add') }}"
       class="btn btn-warning">
        <i class="fa-solid fa-plus me-1"></i> Ajouter un burger
    </a>
</div>


<div class="row">
    {% for burger in burgers %}
        <div class="col-md-4 mb-4">
            <div class="card burger-card h-100 shadow-sm border-0 rounded-4">

                <img
                    src="{{ burger.imageUrl ?: 'https://via.placeholder.com/300x200' }}"
                    class="card-img-top rounded-top-4"
                    alt="{{ burger.nom }}"
                >

                <div class="card-body d-flex flex-column">

                    
                    <span class="badge 
                        {{ burger.etat.value == 'DISPONIBLE' ? 'bg-success' : 'bg-secondary' }}
                        align-self-start mb-2">
                        {{ burger.etat.value }}
                    </span>

                    
                    <h6 class="fw-bold mb-1">{{ burger.nom }}</h6>

                   
                    <p class="price fw-semibold mb-3 text-muted">
                        {{ burger.prix|number_format(0, ',', ' ') }} FCFA
                    </p>

                    
                    <div class="mt-auto d-flex gap-2">

                        
                        <a href="{{ path('app_gestionnaire_burger_edit', {id: burger.id}) }}"
                           class="btn btn-outline-primary btn-sm w-100">
                            <i class="fa-solid fa-pen me-1"></i>
                            Modifier
                        </a>

                        
                        <form method="post"
                              action="{{ path('app_gestionnaire_burger_delete', {id: burger.id}) }}"
                              onsubmit="return confirm('Voulez-vous vraiment supprimer ce burger ?');"
                              class="w-100">

                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete_burger_' ~ burger.id) }}">

                            <button class="btn btn-outline-danger btn-sm w-100">
                                <i class="fa-solid fa-trash me-1"></i>
                                Supprimer
                            </button>
                        </form>

                    </div>

                </div>

            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info text-center">
                Aucun burger enregistré pour le moment.
            </div>
        </div>
    {% endfor %}
</div>


{% if totalPages > 1 %}
<div class="row mt-4">
    <div class="col-12">
        <nav>
            <ul class="pagination justify-content-center">

                {% if page > 1 %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_gestionnaire_burgers', { page: page - 1 }) }}">
                            ‹
                        </a>
                    </li>
                {% endif %}

                {% for p in 1..totalPages %}
                    <li class="page-item {{ p == page ? 'active' }}">
                        <a class="page-link"
                           href="{{ path('app_gestionnaire_burgers', { page: p }) }}">
                            {{ p }}
                        </a>
                    </li>
                {% endfor %}

                {% if page < totalPages %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_gestionnaire_burgers', { page: page + 1 }) }}">
                            ›
                        </a>
                    </li>
                {% endif %}

            </ul>
        </nav>
    </div>
</div>
{% endif %}

{% endblock %}
