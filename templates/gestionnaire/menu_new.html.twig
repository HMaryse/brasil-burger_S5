{% extends 'base.html.twig' %}
{% block title %}Ajouter un Menu{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="page-header mb-4">
        <div>
            <h4 class="fw-bold">Ajouter un menu</h4>
            <p class="text-muted mb-0">
                Choisir un burger et un complément pour composer le menu
            </p>
        </div>

        <a href="{{ path('app_gestionnaire_menus') }}"
           class="btn btn-light border rounded-pill">
            ← Retour
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-5">

                    {{ form_start(form) }}

                        <div class="mb-4">
                            {{ form_row(form.nom) }}
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    🍔 Burger
                                </label>
                                <select class="form-select" id="burger-select">
                                    <option value="">-- Sélectionner un burger --</option>
                                    {% for burger in burgers %}
                                        <option value="{{ burger.id }}"
                                                data-prix="{{ burger.prix }}">
                                            {{ burger.nom }} — {{ burger.prix }} FCFA
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    🥤 Complément
                                </label>
                                <select class="form-select" id="complement-select">
                                    <option value="">-- Sélectionner un complément --</option>
                                    {% for complement in complements %}
                                        <option value="{{ complement.id }}"
                                                data-prix="{{ complement.prix }}">
                                            {{ complement.nom }} — {{ complement.prix }} FCFA
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <input type="hidden" name="burger_id" id="burger-id">
                        <input type="hidden" name="complement_id" id="complement-id">

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                💰 Prix du menu
                            </label>
                            {{ form_widget(form.prix, {
                                'attr': {
                                    'readonly': true,
                                    'id': 'menu-prix',
                                    'class': 'form-control fw-bold text-danger'
                                }
                            }) }}
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                {{ form_row(form.imageUrl) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.etat) }}
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4">
                            <a href="{{ path('app_gestionnaire_menus') }}"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                Annuler
                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-pill px-4">
                                <i class="fa-solid fa-check"></i> Enregistrer
                            </button>
                        </div>

                    {{ form_end(form) }}

                </div>
            </div>

        </div>
    </div>

</div>

<script>
    const burgerSelect = document.getElementById('burger-select');
    const complementSelect = document.getElementById('complement-select');
    const prixInput = document.getElementById('menu-prix');

    const burgerIdInput = document.getElementById('burger-id');
    const complementIdInput = document.getElementById('complement-id');

    function calculerPrix() {
        const prixBurger =
            burgerSelect.selectedOptions[0]?.dataset.prix || 0;
        const prixComplement =
            complementSelect.selectedOptions[0]?.dataset.prix || 0;

        prixInput.value =
            parseFloat(prixBurger) + parseFloat(prixComplement);
    }

    burgerSelect.addEventListener('change', () => {
        burgerIdInput.value = burgerSelect.value;
        calculerPrix();
    });

    complementSelect.addEventListener('change', () => {
        complementIdInput.value = complementSelect.value;
        calculerPrix();
    });
</script>
{% endblock %}
